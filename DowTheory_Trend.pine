// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Dow Theory EA - Converted to Pine Script v6
// EA Dow Theory - Auto Swing + Trendline + Entry/Exit Strategies + Stats
// 1. หา Swing High/Low อัตโนมัติ (Fractal)
// 2. วาด Trendline เขียว(ขึ้น) แดง(ลง)
// 3. บอกสถานะ Trend ปัจจุบัน HH/HL/LH/LL
// 4. สัญญาณเข้าเทรด 3 กลยุทธ์ (เลือกจาก dropdown)
//    - Strategy 1: Pullback to Trendline
//    - Strategy 2: Break of Structure (BOS)
//    - Strategy 3: Trendline Break Reversal
// 5. Exit system: SL (swing + ATR buffer), TP (Swing Target / Risk:Reward /
//    Trailing Swing), Structure Exit เมื่อโครงสร้าง Dow เปลี่ยน
// 6. Stats tables สไตล์ V10.1: Main Stats / By Day / Daily Log / Monthly

//@version=6
indicator("Dow Theory Trend", overlay=true, max_lines_count=500, max_labels_count=500)

// === Inputs ===
inpLeftRight    = input.int(3, "Swing Left/Right Bars (Fractal)", minval=1, maxval=20)
inpLookback     = input.int(300, "Lookback Bars", minval=50, maxval=1000)
inpShowLabels   = input.bool(true, "Show HH/HL/LH/LL Labels")
inpRay          = input.bool(true, "Extend Trendline Right")
inpUpColor      = input.color(color.lime, "Uptrend Color")
inpDownColor    = input.color(color.red, "Downtrend Color")
inpShowPanel    = input.bool(true, "Show Info Panel")

// --- Strategy Selector ---
STRAT_NONE = "None"
STRAT_1    = "Strategy 1: Pullback to Trendline"
STRAT_2    = "Strategy 2: Break of Structure (BOS)"
STRAT_3    = "Strategy 3: Trendline Break Reversal"
STRAT_ALL  = "All Strategies"

inpStrategy = input.string(STRAT_2, "Entry Strategy",
     options=[STRAT_NONE, STRAT_1, STRAT_2, STRAT_3, STRAT_ALL],
     group="Entry Signals")

useS1 = inpStrategy == STRAT_1 or inpStrategy == STRAT_ALL
useS2 = inpStrategy == STRAT_2 or inpStrategy == STRAT_ALL
useS3 = inpStrategy == STRAT_3 or inpStrategy == STRAT_ALL

// --- Exit Settings ---
TP_SWING = "Swing Target"
TP_RR    = "Risk:Reward"
TP_TRAIL = "Trailing Swing"

inpTpMode        = input.string(TP_RR, "TP Mode", options=[TP_SWING, TP_RR, TP_TRAIL], group="Exit Settings")
inpRR            = input.float(2.0, "Risk:Reward Ratio", minval=0.5, step=0.5, group="Exit Settings")
inpAtrLen        = input.int(14, "ATR Length (SL Buffer)", minval=1, group="Exit Settings")
inpSlBufMult     = input.float(0.5, "SL Buffer (ATR multiplier)", minval=0.0, step=0.1, group="Exit Settings")
inpShowExitLines = input.bool(true, "Show Entry/SL/TP Lines", group="Exit Settings")

// --- Display & Stats (สไตล์ V10.1) ---
showStatsTable   = input.bool(true,  " Show Stats Table", group="Display & Stats")
showDayTable     = input.bool(false, " Show By-Day Table (Winrate แยกวันในสัปดาห์)", group="Display & Stats")
showDailyTable   = input.bool(false, " Show Daily Stats Table (Winrate รายวันของเดือน)", group="Display & Stats")
showMonthlyTable = input.bool(true,  " Show Monthly Stats Table (สรุปรายเดือน)", group="Display & Stats")

statMode   = input.string("2. ย้อนหลังตามจำนวนเดือน (Months)", title="▶ เลือกโหมดดูสถิติ (Dropdown)", options=["1. ย้อนหลังตามจำนวนวัน (Days)", "2. ย้อนหลังตามจำนวนเดือน (Months)", "3. เจาะจงเดือนและปี (Specific Month)"], group="Display & Stats")
statDays   = input.int(30, title="[โหมด 1] ย้อนหลัง (วัน)", minval=1, maxval=365, group="Display & Stats")
statMonths = input.int(8, title="[โหมด 2] ย้อนหลัง (เดือน) [1-12]", minval=1, maxval=12, group="Display & Stats")
statTargetM = input.string("August", title="[โหมด 3] ระบุเดือน", options=["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], group="Display & Stats")
statTargetY = input.int(0, title="[โหมด 3] ระบุปี (ใส่ 0 = ดึงปีปัจจุบันอัตโนมัติ)", minval=0, maxval=2100, group="Display & Stats")

mainTablePosStr    = input.string("Bottom Right",  title="▶ ตำแหน่งตารางหลัก (Stats)",       options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")
monthlyTablePosStr = input.string("Bottom Center", title="▶ ตำแหน่งตาราง Monthly (By Month)", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")
dailyTablePosStr   = input.string("Middle Left",   title="▶ ตำแหน่งตาราง Daily (By Date)",    options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")
dayTablePosStr     = input.string("Middle Right",  title="▶ ตำแหน่งตารางแยกวัน (By Day)",   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")

showSun = input.bool(true, title="  ├ แสดง Sunday",    group="Display & Stats")
showMon = input.bool(true, title="  ├ แสดง Monday",    group="Display & Stats")
showTue = input.bool(true, title="  ├ แสดง Tuesday",   group="Display & Stats")
showWed = input.bool(true, title="  ├ แสดง Wednesday", group="Display & Stats")
showThu = input.bool(true, title="  ├ แสดง Thursday",  group="Display & Stats")
showFri = input.bool(true, title="  ├ แสดง Friday",    group="Display & Stats")
showSat = input.bool(true, title="  └ แสดง Saturday",  group="Display & Stats")

int enabledDayCnt = (showSun ? 1 : 0) + (showMon ? 1 : 0) + (showTue ? 1 : 0) + (showWed ? 1 : 0) + (showThu ? 1 : 0) + (showFri ? 1 : 0) + (showSat ? 1 : 0)

// --- Timezone ---
tz_incr      = input.int(0, title="UTC (+/-)", group="Timezone")
use_exchange = input.bool(false, title=" Timezone Exchange", group="Timezone")
var tz = use_exchange ? syminfo.timezone : str.format("UTC{0}{1}", tz_incr >= 0 ? "+" : "-", math.abs(tz_incr))

// --- Helper: แปลง string → table position ---
f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

int currentYear   = year(timenow, tz)
int actualTargetY = statTargetY == 0 ? currentYear : statTargetY

// --- Trade result arrays (เก็บผลเทรดปิดแล้ว) ---
var array<bool>   resIsWin   = array.new_bool()
var array<float>  resTradeRR = array.new_float()
var array<int>    resTime    = array.new_int()
var array<float>  resTpPts   = array.new_float()
var array<string> resTag     = array.new_string()

// --- Day list (ใช้กับโหมดสถิติแบบวัน) ---
var array<int> dayList = array.new_int()
int curDayId = (year(time, tz) * 10000) + (month(time, tz) * 100) + dayofmonth(time, tz)
bool needPushDay = array.size(dayList) == 0
if not needPushDay
    needPushDay := array.get(dayList, array.size(dayList) - 1) != curDayId
if needPushDay
    array.push(dayList, curDayId)
    if array.size(dayList) > 400
        array.shift(dayList)

// === Swing Detection (Fractal) ===
isSwingHigh = ta.pivothigh(high, inpLeftRight, inpLeftRight)
isSwingLow  = ta.pivotlow(low, inpLeftRight, inpLeftRight)

// === Collect Swing Highs & Lows ===
var float[] swingHighPrices = array.new_float()
var int[]   swingHighBars   = array.new_int()
var float[] swingLowPrices  = array.new_float()
var int[]   swingLowBars    = array.new_int()

var line upTrendLine   = na
var line downTrendLine = na

swingOffset = inpLeftRight

if not na(isSwingHigh)
    array.push(swingHighPrices, isSwingHigh)
    array.push(swingHighBars, bar_index - swingOffset)
    if array.size(swingHighPrices) > inpLookback
        array.shift(swingHighPrices)
        array.shift(swingHighBars)

if not na(isSwingLow)
    array.push(swingLowPrices, isSwingLow)
    array.push(swingLowBars, bar_index - swingOffset)
    if array.size(swingLowPrices) > inpLookback
        array.shift(swingLowPrices)
        array.shift(swingLowBars)

// === Dow Theory Analysis ===
hCount = array.size(swingHighPrices)
lCount = array.size(swingLowPrices)

var string trendState = "SIDEWAY"
var color  trendColor = color.orange

bool  isUpTrend   = false
bool  isDownTrend = false
float upLineVal   = na   // ราคาของเส้น Uptrend ที่แท่งปัจจุบัน
float downLineVal = na   // ราคาของเส้น Downtrend ที่แท่งปัจจุบัน
float gLastHigh   = na   // Swing High ล่าสุด (ใช้คำนวณ SL/TP)
float gLastLow    = na   // Swing Low ล่าสุด (ใช้คำนวณ SL/TP)

if hCount >= 2 and lCount >= 2
    lastHigh = array.get(swingHighPrices, hCount - 1)
    prevHigh = array.get(swingHighPrices, hCount - 2)
    lastLow  = array.get(swingLowPrices, lCount - 1)
    prevLow  = array.get(swingLowPrices, lCount - 2)

    lastHighBar = array.get(swingHighBars, hCount - 1)
    prevHighBar = array.get(swingHighBars, hCount - 2)
    lastLowBar  = array.get(swingLowBars, lCount - 1)
    prevLowBar  = array.get(swingLowBars, lCount - 2)

    gLastHigh := lastHigh
    gLastLow  := lastLow

    isHH = lastHigh > prevHigh
    isHL = lastLow > prevLow
    isLL = lastLow < prevLow
    isLH = lastHigh < prevHigh

    isUpTrend   := isHH and isHL
    isDownTrend := isLL and isLH

    if isUpTrend
        trendState := "UPTREND - HH + HL"
        trendColor := inpUpColor
    else if isDownTrend
        trendState := "DOWNTREND - LL + LH"
        trendColor := inpDownColor
    else
        trendState := "SIDEWAY / CORRECTION"
        trendColor := color.orange

    // === Draw Trendlines ===
    extendStyle = inpRay ? extend.right : extend.none

    // Uptrend line: Low -> Low
    if not na(upTrendLine)
        line.delete(upTrendLine)
    upTrendLine := line.new(
         prevLowBar, prevLow,
         lastLowBar, lastLow,
         color=inpUpColor,
         width=isUpTrend ? 3 : 1,
         style=line.style_solid,
         extend=extendStyle)

    // Downtrend line: High -> High
    if not na(downTrendLine)
        line.delete(downTrendLine)
    downTrendLine := line.new(
         prevHighBar, prevHigh,
         lastHighBar, lastHigh,
         color=inpDownColor,
         width=isDownTrend ? 3 : 1,
         style=line.style_solid,
         extend=extendStyle)

    // ราคาของเส้น trend ณ แท่งปัจจุบัน (extrapolate ไปข้างหน้า)
    upLineVal   := line.get_price(upTrendLine, bar_index)
    downLineVal := line.get_price(downTrendLine, bar_index)

    // === Swing Labels (HH/HL/LH/LL) ===
    if inpShowLabels
        if not na(isSwingHigh)
            labelHigh = isHH ? "HH" : "LH"
            label.new(
                 bar_index - swingOffset, isSwingHigh,
                 text=labelHigh,
                 style=label.style_label_down,
                 color=color.new(color.white, 100),
                 textcolor=inpDownColor,
                 size=size.small)

        if not na(isSwingLow)
            labelLow = isHL ? "HL" : "LL"
            label.new(
                 bar_index - swingOffset, isSwingLow,
                 text=labelLow,
                 style=label.style_label_up,
                 color=color.new(color.white, 100),
                 textcolor=inpUpColor,
                 size=size.small)

// ==================================================================
// === Entry Signals ===
// ==================================================================

// --- Strategy 1: Pullback to Trendline ---
// Uptrend ยืนยันแล้ว + ราคาย่อลงมาแตะเส้น Uptrend แล้วปิดกลับเหนือเส้น -> Buy
// Downtrend ยืนยันแล้ว + ราคาดีดขึ้นไปแตะเส้น Downtrend แล้วปิดกลับใต้เส้น -> Sell
s1BuyRaw  = isUpTrend and not na(upLineVal) and low <= upLineVal and close > upLineVal
s1SellRaw = isDownTrend and not na(downLineVal) and high >= downLineVal and close < downLineVal
s1Buy  = s1BuyRaw and not s1BuyRaw[1]    // ยิงเฉพาะแท่งแรกที่แตะ ไม่ยิงซ้ำติดกัน
s1Sell = s1SellRaw and not s1SellRaw[1]

// --- Strategy 2: Break of Structure (BOS) ---
// สถานะเพิ่งเปลี่ยนเป็น UPTREND ครั้งแรก (แท่งที่ครบ HH+HL) -> Buy
// สถานะเพิ่งเปลี่ยนเป็น DOWNTREND ครั้งแรก (แท่งที่ครบ LL+LH) -> Sell
s2Buy  = isUpTrend and not isUpTrend[1]
s2Sell = isDownTrend and not isDownTrend[1]

// --- Strategy 3: Trendline Break Reversal ---
// เดิมเป็น Uptrend แล้วราคาปิดทะลุลงใต้เส้น Uptrend -> Sell (สัญญาณกลับตัว)
// เดิมเป็น Downtrend แล้วราคาปิดทะลุขึ้นเหนือเส้น Downtrend -> Buy (สัญญาณกลับตัว)
s3SellRaw = isUpTrend and not na(upLineVal) and close < upLineVal
s3BuyRaw  = isDownTrend and not na(downLineVal) and close > downLineVal
s3Sell = s3SellRaw and not s3SellRaw[1]
s3Buy  = s3BuyRaw and not s3BuyRaw[1]

// --- รวมสัญญาณตาม dropdown ---
buySignal  = (useS1 and s1Buy) or (useS2 and s2Buy) or (useS3 and s3Buy)
sellSignal = (useS1 and s1Sell) or (useS2 and s2Sell) or (useS3 and s3Sell)

// --- วาด label วงกลมเล็กที่จุดเข้าออเดอร์ ---
if barstate.isconfirmed and buySignal
    buyTip = (useS1 and s1Buy ? "S1 Pullback Buy\n" : "") +
             (useS2 and s2Buy ? "S2 BOS Buy (HH+HL ครั้งแรก)\n" : "") +
             (useS3 and s3Buy ? "S3 Trendline Break Buy\n" : "")
    label.new(bar_index, na,
         style=label.style_circle,
         color=inpUpColor,
         size=size.tiny,
         yloc=yloc.belowbar,
         tooltip="BUY\n" + buyTip)

if barstate.isconfirmed and sellSignal
    sellTip = (useS1 and s1Sell ? "S1 Pullback Sell\n" : "") +
              (useS2 and s2Sell ? "S2 BOS Sell (LL+LH ครั้งแรก)\n" : "") +
              (useS3 and s3Sell ? "S3 Trendline Break Sell\n" : "")
    label.new(bar_index, na,
         style=label.style_circle,
         color=inpDownColor,
         size=size.tiny,
         yloc=yloc.abovebar,
         tooltip="SELL\n" + sellTip)

// ==================================================================
// === Exit System (SL / TP / Trailing / Structure Exit) ===
// ==================================================================

atrVal   = ta.atr(inpAtrLen)
slBuffer = atrVal * inpSlBufMult

// --- Structure Exit conditions (ทำงานทุก strategy ไม่ขึ้นกับ dropdown) ---
// Long ออกเมื่อ: เส้น Uptrend หัก (S3 Sell) หรือ โครงสร้างกลายเป็น DOWNTREND (S2 Sell)
// Short ออกเมื่อ: เส้น Downtrend หัก (S3 Buy) หรือ โครงสร้างกลายเป็น UPTREND (S2 Buy)
structExitLong  = s3Sell or s2Sell
structExitShort = s3Buy or s2Buy

// --- Virtual position state ---
var int    posDir       = 0     // 0 = flat, 1 = long, -1 = short
var float  entryPrice   = na
var float  slPrice      = na
var float  tpPrice      = na
var float  initRisk     = na    // ระยะ 1R ตอนเข้า (|entry - SL แรก|) ใช้คำนวณ R
var int    tradeTime    = na    // เวลาเปิดสถานะ (บันทึกลง stats)
var string tradeTag     = ""    // strategy ที่เปิดสถานะนี้ (S1/S2/S3)
var line   entryLine    = na
var line   slLine       = na
var line   tpLine       = na

bool exitLongEvent  = false
bool exitShortEvent = false
bool exitBySL       = false
bool exitByTP       = false
bool exitByStruct   = false
string exitReason   = ""

// --- บันทึกผลเทรดลง result arrays ---
f_recordResult(float pnlDist, float riskDist, int t, string tag) =>
    float actualR = riskDist > 0 ? pnlDist / riskDist : 0.0
    array.push(resIsWin, actualR > 0)
    array.push(resTradeRR, actualR)
    array.push(resTime, t)
    array.push(resTpPts, math.abs(pnlDist))
    array.push(resTag, tag)
    if array.size(resIsWin) > 5000
        array.shift(resIsWin)
        array.shift(resTradeRR)
        array.shift(resTime)
        array.shift(resTpPts)
        array.shift(resTag)

// --- Trailing Swing: เลื่อน SL ตาม swing ใหม่ ---
if posDir == 1 and inpTpMode == TP_TRAIL and not na(isSwingLow)
    newSL = isSwingLow - slBuffer
    if newSL > slPrice
        slPrice := newSL
        if not na(slLine)
            line.set_y1(slLine, slPrice)
            line.set_y2(slLine, slPrice)

if posDir == -1 and inpTpMode == TP_TRAIL and not na(isSwingHigh)
    newSL = isSwingHigh + slBuffer
    if newSL < slPrice
        slPrice := newSL
        if not na(slLine)
            line.set_y1(slLine, slPrice)
            line.set_y2(slLine, slPrice)

// --- Exit check (เช็คตอนแท่งปิดยืนยัน: SL ก่อน -> TP -> Structure -> Reverse) ---
if barstate.isconfirmed and posDir == 1
    if low <= slPrice
        exitLongEvent := true
        exitBySL := true
        exitReason := inpTpMode == TP_TRAIL ? "Trailing SL hit" : "SL hit"
    else if inpTpMode != TP_TRAIL and not na(tpPrice) and high >= tpPrice
        exitLongEvent := true
        exitByTP := true
        exitReason := "TP hit"
    else if structExitLong
        exitLongEvent := true
        exitByStruct := true
        exitReason := s3Sell ? "Structure: uptrend line broken" : "Structure: Dow flipped to DOWNTREND"
    else if sellSignal
        exitLongEvent := true
        exitByStruct := true
        exitReason := "Reverse signal (Sell)"

if barstate.isconfirmed and posDir == -1
    if high >= slPrice
        exitShortEvent := true
        exitBySL := true
        exitReason := inpTpMode == TP_TRAIL ? "Trailing SL hit" : "SL hit"
    else if inpTpMode != TP_TRAIL and not na(tpPrice) and low <= tpPrice
        exitShortEvent := true
        exitByTP := true
        exitReason := "TP hit"
    else if structExitShort
        exitShortEvent := true
        exitByStruct := true
        exitReason := s3Buy ? "Structure: downtrend line broken" : "Structure: Dow flipped to UPTREND"
    else if buySignal
        exitShortEvent := true
        exitByStruct := true
        exitReason := "Reverse signal (Buy)"

// --- Execute exit: วงกลมส้ม + tooltip เหตุผล + บันทึก stats แล้วเคลียร์สถานะ ---
if exitLongEvent
    exitPx = exitBySL ? slPrice : exitByTP ? tpPrice : close
    f_recordResult(exitPx - entryPrice, initRisk, tradeTime, tradeTag)
    label.new(bar_index, na,
         style=label.style_circle,
         color=color.orange,
         size=size.tiny,
         yloc=yloc.abovebar,
         tooltip="EXIT LONG\n" + exitReason +
             "\nEntry: " + str.tostring(entryPrice, format.mintick) +
             "\nExit: " + str.tostring(exitPx, format.mintick))
    posDir := 0
    entryPrice := na
    slPrice := na
    tpPrice := na
    initRisk := na
    entryLine := na
    slLine := na
    tpLine := na

if exitShortEvent
    exitPx = exitBySL ? slPrice : exitByTP ? tpPrice : close
    f_recordResult(entryPrice - exitPx, initRisk, tradeTime, tradeTag)
    label.new(bar_index, na,
         style=label.style_circle,
         color=color.orange,
         size=size.tiny,
         yloc=yloc.belowbar,
         tooltip="EXIT SHORT\n" + exitReason +
             "\nEntry: " + str.tostring(entryPrice, format.mintick) +
             "\nExit: " + str.tostring(exitPx, format.mintick))
    posDir := 0
    entryPrice := na
    slPrice := na
    tpPrice := na
    initRisk := na
    entryLine := na
    slLine := na
    tpLine := na

// --- Entry: เปิดสถานะใหม่เมื่อ flat (รวมกรณี reverse ที่เพิ่งออกแท่งเดียวกัน) ---
if barstate.isconfirmed and buySignal and posDir == 0
    posDir := 1
    entryPrice := close
    tradeTime := time
    tradeTag := (useS1 and s1Buy ? "S1" : useS2 and s2Buy ? "S2" : "S3")
    // SL: ใต้ Swing Low ล่าสุด - buffer (ถ้าผิดปกติใช้ ATR เต็มแทน)
    slPrice := gLastLow - slBuffer
    if na(slPrice) or slPrice >= entryPrice
        slPrice := entryPrice - atrVal
    initRisk := entryPrice - slPrice
    // TP ตามโหมด
    if inpTpMode == TP_RR
        tpPrice := entryPrice + (entryPrice - slPrice) * inpRR
    else if inpTpMode == TP_SWING
        // เป้า = Swing High เดิม; ถ้าราคา break ไปแล้วใช้ measured move (HH-HL) แทน
        tpPrice := gLastHigh > entryPrice ? gLastHigh : entryPrice + (gLastHigh - gLastLow)
        if na(tpPrice) or tpPrice <= entryPrice
            tpPrice := entryPrice + (entryPrice - slPrice) * inpRR
    else
        tpPrice := na
    if inpShowExitLines
        entryLine := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color=color.gray, style=line.style_dotted, width=1)
        slLine := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_dashed, width=1)
        if not na(tpPrice)
            tpLine := line.new(bar_index, tpPrice, bar_index + 1, tpPrice, color=color.green, style=line.style_dashed, width=1)

if barstate.isconfirmed and sellSignal and posDir == 0
    posDir := -1
    entryPrice := close
    tradeTime := time
    tradeTag := (useS1 and s1Sell ? "S1" : useS2 and s2Sell ? "S2" : "S3")
    // SL: เหนือ Swing High ล่าสุด + buffer
    slPrice := gLastHigh + slBuffer
    if na(slPrice) or slPrice <= entryPrice
        slPrice := entryPrice + atrVal
    initRisk := slPrice - entryPrice
    if inpTpMode == TP_RR
        tpPrice := entryPrice - (slPrice - entryPrice) * inpRR
    else if inpTpMode == TP_SWING
        tpPrice := gLastLow < entryPrice ? gLastLow : entryPrice - (gLastHigh - gLastLow)
        if na(tpPrice) or tpPrice >= entryPrice
            tpPrice := entryPrice - (slPrice - entryPrice) * inpRR
    else
        tpPrice := na
    if inpShowExitLines
        entryLine := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color=color.gray, style=line.style_dotted, width=1)
        slLine := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_dashed, width=1)
        if not na(tpPrice)
            tpLine := line.new(bar_index, tpPrice, bar_index + 1, tpPrice, color=color.green, style=line.style_dashed, width=1)

// --- ยืดเส้น Entry/SL/TP ตามแท่งขณะถือสถานะ ---
if posDir != 0
    if not na(entryLine)
        line.set_x2(entryLine, bar_index)
    if not na(slLine)
        line.set_x2(slLine, bar_index)
    if not na(tpLine)
        line.set_x2(tpLine, bar_index)

// === Info Panel (Table) ===
if inpShowPanel and barstate.islast and hCount >= 2 and lCount >= 2
    lastHigh2 = array.get(swingHighPrices, hCount - 1)
    prevHigh2 = array.get(swingHighPrices, hCount - 2)
    lastLow2  = array.get(swingLowPrices, lCount - 1)
    prevLow2  = array.get(swingLowPrices, lCount - 2)

    var table panel = table.new(position.top_left, 2, 8, bgcolor=color.new(color.black, 70), border_width=1)

    table.cell(panel, 0, 0, "Dow Theory", text_color=trendColor, text_size=size.normal, text_halign=text.align_left)
    table.cell(panel, 1, 0, trendState, text_color=trendColor, text_size=size.normal, text_halign=text.align_left)

    table.cell(panel, 0, 1, "Last High", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 1, str.tostring(lastHigh2, format.mintick) + (lastHigh2 > prevHigh2 ? " (HH)" : " (LH)"), text_color=lastHigh2 > prevHigh2 ? inpUpColor : inpDownColor, text_size=size.small, text_halign=text.align_left)

    table.cell(panel, 0, 2, "Prev High", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 2, str.tostring(prevHigh2, format.mintick), text_color=color.gray, text_size=size.small, text_halign=text.align_left)

    table.cell(panel, 0, 3, "Last Low", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 3, str.tostring(lastLow2, format.mintick) + (lastLow2 > prevLow2 ? " (HL)" : " (LL)"), text_color=lastLow2 > prevLow2 ? inpUpColor : inpDownColor, text_size=size.small, text_halign=text.align_left)

    table.cell(panel, 0, 4, "Prev Low", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 4, str.tostring(prevLow2, format.mintick), text_color=color.gray, text_size=size.small, text_halign=text.align_left)

    table.cell(panel, 0, 5, "Strategy", text_color=color.aqua, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 5, inpStrategy, text_color=color.aqua, text_size=size.small, text_halign=text.align_left)

    table.cell(panel, 0, 6, "TP Mode", text_color=color.aqua, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 6, inpTpMode + (inpTpMode == TP_RR ? " (1:" + str.tostring(inpRR) + ")" : ""), text_color=color.aqua, text_size=size.small, text_halign=text.align_left)

    posText  = posDir == 1 ? "LONG @ " + str.tostring(entryPrice, format.mintick) : posDir == -1 ? "SHORT @ " + str.tostring(entryPrice, format.mintick) : "FLAT"
    posColor = posDir == 1 ? inpUpColor : posDir == -1 ? inpDownColor : color.gray
    posDetail = posDir != 0 ? " | SL " + str.tostring(slPrice, format.mintick) + (not na(tpPrice) ? " | TP " + str.tostring(tpPrice, format.mintick) : "") : ""
    table.cell(panel, 0, 7, "Position", text_color=posColor, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 7, posText + posDetail, text_color=posColor, text_size=size.small, text_halign=text.align_left)

// === Background Color Hint ===
bgcolor(hCount >= 2 and lCount >= 2 ? color.new(trendColor, 95) : na)

// ==================================================================
// === STATS TABLES (สไตล์ V10.1: Luxe Theme) ===
// ==================================================================

// --- LUXE TABLE THEME (โทนหรู: กระจกเข้ม + กรอบทอง + แถวสลับมีมิติ) ---
color lxGold    = color.rgb(212, 175, 55)
color lxTitleTx = color.rgb(236, 210, 140)
color lxHeadBg  = color.new(color.rgb(26, 32, 52), 6)
color lxSubBg   = color.new(color.rgb(19, 24, 40), 8)
color lxColHd   = color.rgb(150, 160, 182)
color lxRowA    = color.new(color.rgb(13, 17, 28), 14)
color lxRowB    = color.new(color.rgb(22, 28, 46), 14)
color lxRowDim  = color.new(color.rgb(13, 17, 28), 52)
color lxText    = color.rgb(233, 236, 243)
color lxMuted   = color.rgb(128, 138, 158)
color lxDimTx   = color.rgb(90, 98, 116)
color lxGreen   = color.rgb(64, 216, 158)
color lxRed     = color.rgb(250, 118, 118)
color lxAmber   = color.rgb(251, 191, 36)
color lxCyan    = color.rgb(102, 208, 255)
color lxFrame   = color.new(lxGold, 42)
color lxGrid    = color.new(color.rgb(7, 10, 17), 35)
color lxBestBg  = color.new(lxGold, 84)

// แถบ winrate 10 ช่อง ▰▰▰▰▰▰▱▱▱▱
f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for _b = 1 to 10
        s += _b <= filled ? "▰" : "▱"
    s

f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        =>    "Dec"

int targetMonthNum = statTargetM == "January" ? 1 : statTargetM == "February" ? 2 : statTargetM == "March" ? 3 : statTargetM == "April" ? 4 : statTargetM == "May" ? 5 : statTargetM == "June" ? 6 : statTargetM == "July" ? 7 : statTargetM == "August" ? 8 : statTargetM == "September" ? 9 : statTargetM == "October" ? 10 : statTargetM == "November" ? 11 : 12

int nDaysStat  = math.min(statDays, array.size(dayList))
int cutoffStat = 0
if array.size(dayList) > 0
    cutoffStat := array.get(dayList, array.size(dayList) - nDaysStat)
int currentTotalM = year(timenow, tz) * 12 + month(timenow, tz)

var table statsTable        = table.new(f_tablePos(mainTablePosStr),    2, 14,                 bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dayStatsTable     = table.new(f_tablePos(dayTablePosStr),     4, 3 + enabledDayCnt,  bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dailyStatsTable   = table.new(f_tablePos(dailyTablePosStr),   6, 34,                 bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table monthlyStatsTable = table.new(f_tablePos(monthlyTablePosStr), 5, statMonths + 3,     bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var bool lxMerged1 = false
var bool lxMerged2 = false
var bool lxMerged3 = false
var bool lxMerged4 = false

// ==========================================
// --- ตารางที่ 1: MAIN STATS ---
// ==========================================
if showStatsTable and barstate.islast
    int   winCnt  = 0
    int   lossCnt = 0
    int   streak     = 0
    int   maxW       = 0
    int   maxL       = 0
    int   curStreakStart = 0
    int   maxWStart  = 0
    int   maxWEnd    = 0
    int   maxLStart  = 0
    int   maxLEnd    = 0
    float netR       = 0.0
    float curWinSum  = 0.0
    float curLossSum = 0.0
    float maxWinR    = 0.0
    float maxLossR   = 0.0
    // --- Day-of-week arrays (index 1=Sun,2=Mon,...,7=Sat) ---
    int[]   dowWin  = array.new_int(8, 0)
    int[]   dowLoss = array.new_int(8, 0)
    float[] dowNetR = array.new_float(8, 0.0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tDayId = (year(t, tz) * 10000) + (month(t, tz) * 100) + dayofmonth(t, tz)
            bool valid = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                valid := tDayId >= cutoffStat
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                valid := (year(t, tz) * 12 + month(t, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                valid := month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
            if valid
                float tradeR = array.get(resTradeRR, i)
                bool  isWin  = array.get(resIsWin, i)
                int   dow    = dayofweek(t, tz)  // 1=Sun,2=Mon,...,7=Sat
                netR += tradeR
                if streak == 0
                    curStreakStart := t
                if isWin
                    winCnt += 1
                    curWinSum := streak >= 0 ? curWinSum + tradeR : tradeR
                    if streak < 0
                        curStreakStart := t
                    streak := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW      := streak
                        maxWStart := curStreakStart
                        maxWEnd   := t
                    maxWinR := math.max(maxWinR, curWinSum)
                    if dow >= 1 and dow <= 7
                        array.set(dowWin,  dow, array.get(dowWin,  dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)
                else
                    lossCnt += 1
                    curLossSum := streak <= 0 ? curLossSum + tradeR : tradeR
                    if streak > 0
                        curStreakStart := t
                    streak := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL      := -streak
                        maxLStart := curStreakStart
                        maxLEnd   := t
                    maxLossR := math.min(maxLossR, curLossSum)
                    if dow >= 1 and dow <= 7
                        array.set(dowLoss, dow, array.get(dowLoss, dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)
    int   totalCnt  = winCnt + lossCnt
    float wr        = totalCnt > 0 ? (winCnt / totalCnt) * 100 : na
    color wrColor   = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color netRColor = totalCnt == 0 ? lxMuted : netR > 0 ? lxGreen : netR < 0 ? lxRed : lxAmber
    string netRStr  = totalCnt == 0 ? "-" : (netR > 0 ? "+" : "") + str.tostring(netR, "#.##") + "R"
    string streakStr   = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color  streakColor = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted
    string periodStr = ""
    if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        periodStr := "Last " + str.tostring(statDays) + " Days"
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        periodStr := "Last " + str.tostring(statMonths) + " Months"
    else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
        periodStr := statTargetM + " " + str.tostring(actualTargetY)
    string stratShort = inpStrategy == STRAT_1 ? "S1 Pullback" : inpStrategy == STRAT_2 ? "S2 BOS" : inpStrategy == STRAT_3 ? "S3 TL Break" : inpStrategy == STRAT_ALL ? "All (S1+S2+S3)" : "None"
    string tpModeStr  = inpTpMode == TP_RR ? "R:R 1:" + str.tostring(inpRR, "#.#") : inpTpMode == TP_SWING ? "Swing Target" : "Trailing Swing"
    table.cell(statsTable, 0, 0,  "◆  DOW THEORY PERFORMANCE", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(statsTable, 0, 1,  periodStr + "  ·  " + syminfo.ticker + " " + timeframe.period, text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(statsTable, 0, 2,  "Strategy",   text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 2,  stratShort, text_color=lxCyan, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 3,  "TP Mode",    text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 3,  tpModeStr, text_color=lxCyan, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 4,  "Trades",     text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 4,  totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L", text_color=lxText, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 5,  "Winrate",    text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 5,  na(wr) ? "-" : str.tostring(wr, "#.#") + "%\n" + f_wrBar(wr), text_color=wrColor, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 6,  "Net R",      text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 6,  netRStr,      text_color=netRColor, text_size=size.normal, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 7,  "Max Streak", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 7,  "W" + str.tostring(maxW) + " · L" + str.tostring(maxL), text_color=lxAmber, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    string maxWDateStr = maxW > 0 ? str.tostring(dayofmonth(maxWStart, tz)) + " " + f_monthShort(month(maxWStart, tz)) + " – " + str.tostring(dayofmonth(maxWEnd, tz)) + " " + f_monthShort(month(maxWEnd, tz)) : "-"
    string maxLDateStr = maxL > 0 ? str.tostring(dayofmonth(maxLStart, tz)) + " " + f_monthShort(month(maxLStart, tz)) + " – " + str.tostring(dayofmonth(maxLEnd, tz)) + " " + f_monthShort(month(maxLEnd, tz)) : "-"
    table.cell(statsTable, 0, 8,  " W" + str.tostring(maxW) + " Date", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 8,  maxWDateStr, text_color=maxW > 0 ? lxGreen : lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 9,  " L" + str.tostring(maxL) + " Date", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 9,  maxLDateStr, text_color=maxL > 0 ? lxRed : lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 10, "Max Streak R", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 10, totalCnt == 0 ? "-" : "+" + str.tostring(maxWinR, "#.##") + "R · " + str.tostring(maxLossR, "#.##") + "R", text_color=lxAmber, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 11, "Streak",     text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 11, streakStr,    text_color=streakColor, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    string posStr  = posDir == 1 ? "LONG" : posDir == -1 ? "SHORT" : "FLAT"
    color  posCol  = posDir == 1 ? lxGreen : posDir == -1 ? lxRed : lxDimTx
    table.cell(statsTable, 0, 12, "Position",   text_color=lxDimTx, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 12, posStr,       text_color=posCol, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 13, "Trend",      text_color=lxDimTx, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 13, trendState,   text_color=lxAmber, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    if not lxMerged1
        lxMerged1 := true
        table.merge_cells(statsTable, 0, 0, 1, 0)
        table.merge_cells(statsTable, 0, 1, 1, 1)
    // ==========================================
    // --- ตารางที่ 2: WINRATE BY DAY (Sun-Sat) ---
    // ==========================================
    if showDayTable
        table.cell(dayStatsTable, 0, 0, "◆  BY DAY  ·  " + periodStr, text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 0, 1, "DAY",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 1, 1, "W-L",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 2, 1, "WR%",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 3, 1, "NET R", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        // showDayArr index 0=Sun(dow1), 1=Mon(dow2), ..., 6=Sat(dow7)
        bool[] showDayArr = array.from(showSun, showMon, showTue, showWed, showThu, showFri, showSat)
        // หา "วันที่ดีที่สุด" ไว้ไฮไลท์ทอง (เฉพาะวันที่เปิดแสดง)
        int   bestDow = 0
        float bestNR  = 0.0
        for bd = 0 to 6
            int bDow = bd + 1
            if array.get(showDayArr, bd) and array.get(dowWin, bDow) + array.get(dowLoss, bDow) > 0 and array.get(dowNetR, bDow) > bestNR
                bestNR  := array.get(dowNetR, bDow)
                bestDow := bDow
        int   sumW   = 0
        int   sumL   = 0
        float sumR   = 0.0
        int   rowIdx = 2
        for d = 0 to 6
            int dow = d + 1
            if array.get(showDayArr, d)
                int   dw   = array.get(dowWin,  dow)
                int   dl   = array.get(dowLoss, dow)
                float dnr  = array.get(dowNetR, dow)
                int   dtot = dw + dl
                float dwr  = dtot > 0 ? (dw / dtot) * 100.0 : na
                color dwrC = na(dwr) ? lxDimTx : dwr >= 50 ? lxGreen : lxAmber
                color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
                string dName = d == 0 ? "Sun" : d == 1 ? "Mon" : d == 2 ? "Tue" : d == 3 ? "Wed" : d == 4 ? "Thu" : d == 5 ? "Fri" : "Sat"
                string dwlS  = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
                string dwrS  = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
                string dnrS  = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
                bool  isBest = dow == bestDow and dtot > 0
                color rowBg  = isBest ? lxBestBg : rowIdx % 2 == 0 ? lxRowA : lxRowB
                color dnameC = isBest ? lxTitleTx : dtot == 0 ? lxDimTx : lxText
                table.cell(dayStatsTable, 0, rowIdx, (isBest ? "★ " : "") + dName, text_color=dnameC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_left)
                table.cell(dayStatsTable, 1, rowIdx, dwlS, text_color=dtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTable, 2, rowIdx, dwrS, text_color=dwrC, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTable, 3, rowIdx, dnrS, text_color=dnrC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_right)
                sumW   += dw
                sumL   += dl
                sumR   += dnr
                rowIdx += 1
        int   sumTot = sumW + sumL
        float sumWR  = sumTot > 0 ? (sumW / sumTot) * 100.0 : na
        table.cell(dayStatsTable, 0, rowIdx, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
        table.cell(dayStatsTable, 1, rowIdx, sumTot == 0 ? "-" : str.tostring(sumW) + "W · " + str.tostring(sumL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 2, rowIdx, na(sumWR) ? "-" : str.tostring(sumWR, "#.#") + "%", text_color=na(sumWR) ? lxDimTx : sumWR >= 50 ? lxGreen : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 3, rowIdx, sumTot == 0 ? "-" : (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + "R", text_color=sumTot == 0 ? lxDimTx : sumR > 0 ? lxGreen : sumR < 0 ? lxRed : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
        if not lxMerged2
            lxMerged2 := true
            table.merge_cells(dayStatsTable, 0, 0, 3, 0)

// ==========================================
// --- ตารางที่ 3: DAILY WINRATE BY DATE (Specific Month) ---
// ==========================================
if showDailyTable and barstate.islast
    int[]    ddWin      = array.new_int(32, 0)
    int[]    ddLoss     = array.new_int(32, 0)
    float[]  ddNetR     = array.new_float(32, 0.0)
    float[]  ddWinPips  = array.new_float(32, 0.0)
    float[]  ddLossPips = array.new_float(32, 0.0)
    string[] ddTradeStr = array.new_string(32, "")
    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, k)
            if month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
                int   d      = dayofmonth(t, tz)
                bool  isWin  = array.get(resIsWin,   k)
                float tradeR = array.get(resTradeRR, k)
                float tpPts  = array.get(resTpPts,   k)
                string tag   = array.get(resTag,     k)
                if d >= 1 and d <= 31
                    if isWin
                        array.set(ddWin, d, array.get(ddWin, d) + 1)
                        array.set(ddWinPips, d, array.get(ddWinPips, d) + tpPts)
                    else
                        array.set(ddLoss, d, array.get(ddLoss, d) + 1)
                        array.set(ddLossPips, d, array.get(ddLossPips, d) + tpPts)
                    array.set(ddNetR, d, array.get(ddNetR, d) + tradeR)
                    string rSign     = tradeR >= 0 ? "+" : ""
                    string tradeLine = tag + " " + rSign + str.tostring(tradeR, "#.##") + "R\n"
                    array.set(ddTradeStr, d, array.get(ddTradeStr, d) + tradeLine)
    table.cell(dailyStatsTable, 0, 0, "◆  DAILY LOG  ·  " + statTargetM + " " + str.tostring(actualTargetY), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 0, 1, "DATE",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 4, 1, "PTS",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 5, 1, "TRADES", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int   totW = 0
    int   totL = 0
    float totR = 0.0
    float totWinPips  = 0.0
    float totLossPips = 0.0
    for d = 1 to 31
        int   dw   = array.get(ddWin,  d)
        int   dl   = array.get(ddLoss, d)
        float dnr  = array.get(ddNetR, d)
        float dwp  = array.get(ddWinPips,  d)
        float dlp  = array.get(ddLossPips, d)
        int   dtot = dw + dl
        float dwr  = dtot > 0 ? (dw / dtot) * 100.0 : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
        string dwlS  = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
        string dwrS  = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
        string dnrS  = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
        string dpipS = dtot == 0 ? "-" : "+" + str.tostring(dwp, "#.#") + " / -" + str.tostring(dlp, "#.#")
        color  dpipC = dtot == 0 ? lxDimTx : (dwp - dlp) > 0 ? lxGreen : (dwp - dlp) < 0 ? lxRed : lxAmber
        string tradeS = array.get(ddTradeStr, d)
        if str.length(tradeS) > 0
            tradeS := str.substring(tradeS, 0, str.length(tradeS) - 1)
        color dayBg = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC = dtot == 0 ? lxDimTx : lxText
        table.cell(dailyStatsTable, 0, d + 1, str.tostring(d), text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 1, d + 1, dwlS,   text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 2, d + 1, dwrS,   text_color=dwrC,  text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 3, d + 1, dnrS,   text_color=dnrC,  text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 4, d + 1, dpipS,  text_color=dpipC, text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 5, d + 1, tradeS, text_color=color.new(lxText, 22), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_left)
        totW += dw
        totL += dl
        totR += dnr
        totWinPips  += dwp
        totLossPips += dlp
    int   totTot = totW + totL
    float totWR  = totTot > 0 ? (totW / totTot) * 100.0 : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    color totNRC = totTot == 0 ? lxDimTx : totR > 0 ? lxGreen : totR < 0 ? lxRed : lxAmber
    string totWLS  = totTot == 0 ? "-" : str.tostring(totW) + "W · " + str.tostring(totL) + "L"
    string totWRS  = na(totWR) ? "-" : str.tostring(totWR, "#.#") + "%"
    string totNRS  = totTot == 0 ? "-" : (totR >= 0 ? "+" : "") + str.tostring(totR, "#.##") + "R"
    string totPipS = totTot == 0 ? "-" : "+" + str.tostring(totWinPips, "#.#") + " / -" + str.tostring(totLossPips, "#.#")
    color  totPipC = totTot == 0 ? lxDimTx : (totWinPips - totLossPips) > 0 ? lxGreen : (totWinPips - totLossPips) < 0 ? lxRed : lxAmber
    table.cell(dailyStatsTable, 0, 33, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(dailyStatsTable, 1, 33, totWLS,  text_color=lxText,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 2, 33, totWRS,  text_color=totWRC,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 3, 33, totNRS,  text_color=totNRC,    text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 4, 33, totPipS, text_color=totPipC,   text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 5, 33, na(totWR) ? "" : f_wrBar(totWR), text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    if not lxMerged3
        lxMerged3 := true
        table.merge_cells(dailyStatsTable, 0, 0, 5, 0)

// ==========================================
// --- ตารางที่ 4: MONTHLY STATS (สรุปรายเดือน) ---
// ==========================================
if showMonthlyTable and barstate.islast and statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
    int startTotalM = currentTotalM - statMonths + 1
    int[]   mWin    = array.new_int(statMonths, 0)
    int[]   mLoss   = array.new_int(statMonths, 0)
    float[] mNetR   = array.new_float(statMonths, 0.0)
    int[]   mMaxW   = array.new_int(statMonths, 0)
    int[]   mMaxL   = array.new_int(statMonths, 0)
    int[]   mStreak = array.new_int(statMonths, 0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tTotalM = year(t, tz) * 12 + month(t, tz)
            int idx = tTotalM - startTotalM
            if idx >= 0 and idx < statMonths
                float tradeR = array.get(resTradeRR, i)
                bool isWin = array.get(resIsWin, i)
                int curStrk = array.get(mStreak, idx)
                if isWin
                    array.set(mWin, idx, array.get(mWin, idx) + 1)
                    curStrk := curStrk >= 0 ? curStrk + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), curStrk))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    curStrk := curStrk <= 0 ? curStrk - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -curStrk))
                array.set(mStreak, idx, curStrk)
                array.set(mNetR, idx, array.get(mNetR, idx) + tradeR)
    table.cell(monthlyStatsTable, 0, 0, "◆  MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 0, 1, "MONTH",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 4, 1, "STREAK", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin, m) + array.get(mLoss, m)) > 0 and array.get(mNetR, m) > bestMNR
            bestMNR := array.get(mNetR, m)
            bestMIdx := m
    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    for m = 0 to statMonths - 1
        int totalM = startTotalM + m
        int mMon = (totalM - 1) % 12 + 1
        int mYr  = math.round((totalM - mMon) / 12)
        string mLabel = f_monthShort(mMon) + " " + str.tostring(mYr)
        int mw = array.get(mWin, m)
        int ml = array.get(mLoss, m)
        float mnr = array.get(mNetR, m)
        int mtot = mw + ml
        float mwr = mtot > 0 ? (mw * 1.0 / mtot) * 100.0 : na
        color mwrC = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        color mnrC = mtot == 0 ? lxDimTx : mnr > 0 ? lxGreen : mnr < 0 ? lxRed : lxAmber
        string mwlS = mtot == 0 ? "-" : str.tostring(mw) + "W · " + str.tostring(ml) + "L"
        string mwrS = na(mwr) ? "-" : str.tostring(mwr, "#.#") + "%"
        string mnrS = mtot == 0 ? "-" : (mnr >= 0 ? "+" : "") + str.tostring(mnr, "#.##") + "R"
        bool isBestM = m == bestMIdx and mtot > 0
        color mRowBg = isBestM ? lxBestBg : m % 2 == 0 ? lxRowA : lxRowB
        color mLabelC = isBestM ? lxTitleTx : mtot == 0 ? lxDimTx : lxText
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        string mStrkS = mtot == 0 ? "-" : "W" + str.tostring(mmxW) + " · L" + str.tostring(mmxL)
        table.cell(monthlyStatsTable, 0, m + 2, (isBestM ? "★ " : "") + mLabel, text_color=mLabelC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_left)
        table.cell(monthlyStatsTable, 1, m + 2, mwlS, text_color=mtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 2, m + 2, mwrS, text_color=mwrC, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 3, m + 2, mnrS, text_color=mnrC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_right)
        table.cell(monthlyStatsTable, 4, m + 2, mStrkS, text_color=mtot == 0 ? lxDimTx : lxAmber, text_size=size.small, bgcolor=mRowBg)
        mSumW += mw
        mSumL += ml
        mSumR += mnr
    int mSumTot = mSumW + mSumL
    float mSumWR = mSumTot > 0 ? (mSumW * 1.0 / mSumTot) * 100.0 : na
    color mSumWRC = na(mSumWR) ? lxDimTx : mSumWR >= 50 ? lxGreen : lxAmber
    color mSumNRC = mSumTot == 0 ? lxDimTx : mSumR > 0 ? lxGreen : mSumR < 0 ? lxRed : lxAmber
    string mSumWLS = mSumTot == 0 ? "-" : str.tostring(mSumW) + "W · " + str.tostring(mSumL) + "L"
    string mSumWRS = na(mSumWR) ? "-" : str.tostring(mSumWR, "#.#") + "%"
    string mSumNRS = mSumTot == 0 ? "-" : (mSumR >= 0 ? "+" : "") + str.tostring(mSumR, "#.##") + "R"
    int totalRow = statMonths + 2
    int allMaxW = 0
    int allMaxL = 0
    for sm = 0 to statMonths - 1
        allMaxW := math.max(allMaxW, array.get(mMaxW, sm))
        allMaxL := math.max(allMaxL, array.get(mMaxL, sm))
    string allStrkS = mSumTot == 0 ? "-" : "W" + str.tostring(allMaxW) + " · L" + str.tostring(allMaxL)
    table.cell(monthlyStatsTable, 0, totalRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(monthlyStatsTable, 1, totalRow, mSumWLS, text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 2, totalRow, mSumWRS, text_color=mSumWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 3, totalRow, mSumNRS, text_color=mSumNRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(monthlyStatsTable, 4, totalRow, allStrkS, text_color=mSumTot == 0 ? lxDimTx : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    if not lxMerged4
        lxMerged4 := true
        table.merge_cells(monthlyStatsTable, 0, 0, 4, 0)

// === Alert Conditions ===
alertcondition(trendState == "UPTREND - HH + HL", title="Uptrend Detected", message="Dow Theory: UPTREND - HH + HL detected")
alertcondition(trendState == "DOWNTREND - LL + LH", title="Downtrend Detected", message="Dow Theory: DOWNTREND - LL + LH detected")
alertcondition(trendState == "SIDEWAY / CORRECTION", title="Sideway Detected", message="Dow Theory: SIDEWAY / CORRECTION detected")

alertcondition(s1Buy,  title="S1 Pullback Buy",        message="Dow Theory S1: Pullback to uptrend line - BUY")
alertcondition(s1Sell, title="S1 Pullback Sell",       message="Dow Theory S1: Pullback to downtrend line - SELL")
alertcondition(s2Buy,  title="S2 BOS Buy",             message="Dow Theory S2: BOS first HH+HL - BUY")
alertcondition(s2Sell, title="S2 BOS Sell",            message="Dow Theory S2: BOS first LL+LH - SELL")
alertcondition(s3Buy,  title="S3 Trendline Break Buy", message="Dow Theory S3: Break above downtrend line - BUY")
alertcondition(s3Sell, title="S3 Trendline Break Sell",message="Dow Theory S3: Break below uptrend line - SELL")
alertcondition(buySignal,  title="Any Buy Signal",  message="Dow Theory: BUY signal (selected strategy)")
alertcondition(sellSignal, title="Any Sell Signal", message="Dow Theory: SELL signal (selected strategy)")

alertcondition(exitLongEvent,  title="Exit Long",        message="Dow Theory: EXIT LONG (SL/TP/Structure)")
alertcondition(exitShortEvent, title="Exit Short",       message="Dow Theory: EXIT SHORT (SL/TP/Structure)")
alertcondition(exitBySL,       title="Exit - SL Hit",    message="Dow Theory: Exit - Stop Loss hit")
alertcondition(exitByTP,       title="Exit - TP Hit",    message="Dow Theory: Exit - Take Profit hit")
alertcondition(exitByStruct,   title="Exit - Structure", message="Dow Theory: Exit - structure break / reverse signal")
